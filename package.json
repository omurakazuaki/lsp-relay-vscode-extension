{
  "name": "lsp-relay",
  "displayName": "LSP Relay - Semantic Code Search",
  "description": "Exposes VS Code language server capabilities via a local HTTP API for LLM agents",
  "version": "0.1.2",
  "icon": "icon.png",
  "publisher": "local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/local/lsp-relay"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages","AI"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "bin": {
    "semcode": "./out/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "lsp-relay.showStatus",
        "title": "LSP Relay: Show Status"
      },
      {
        "command": "lsp-relay.installCli",
        "title": "LSP Relay: Install CLI"
      },
      {
        "command": "lsp-relay.installSkill",
        "title": "LSP Relay: Install Skill"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "build:extension": "node build.mjs --extension",
    "build:cli": "node build.mjs --cli",
    "package": "npx @vscode/vsce package --no-dependencies -o lsp-relay.vsix",
    "install:ext": "npm run build && npm run package && code --uninstall-extension local.lsp-relay && code --install-extension ./lsp-relay.vsix --force",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  }
}
